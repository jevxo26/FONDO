generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String               @id @default(uuid())
  firstName                   String
  lastName                    String
  phone                       String               @unique
  email                       String               @unique
  password                    String?
  avatar                      String?
  gender                      Gender?
  dateOfBirth                 DateTime?
  role                        Role                 @default(CUSTOMER)
  status                      UserStatus           @default(ACTIVE)
  isPhoneVerified             Boolean              @default(false)
  isEmailVerified             Boolean              @default(false)
  lastLoginAt                 DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  deletedAt                   DateTime?
  vendorId                    String?              @unique
  accountLocked               Boolean              @default(false)
  accountLockedUntil          DateTime?
  bio                         String?
  chatNotification            Boolean              @default(true)
  company                     String?
  emailNotification           Boolean              @default(true)
  failedLoginCount            Int                  @default(0)
  lastFailedLoginAt           DateTime?
  marketingNotification       Boolean              @default(false)
  occupation                  String?
  orderNotification           Boolean              @default(true)
  passwordChangedAt           DateTime?
  paymentNotification         Boolean              @default(true)
  preferredLanguage           String?
  profession                  String?
  profileCompletionPercentage Float?
  promotionNotification       Boolean              @default(false)
  pushNotification            Boolean              @default(true)
  securityAnswer              String?
  securityQuestion            String?
  smsNotification             Boolean              @default(false)
  systemNotification          Boolean              @default(true)
  timezone                    String?
  twoFactorEnabled            Boolean              @default(false)
  activityLogs                ActivityLog[]
  carts                       Cart?
  customMealPlans             CustomMealPlan?
  wallet                      CustomerWallet?
  dietaryRestrictions         DietaryRestriction[]
  favorites                   FoodFavorite[]
  foodReviews                 FoodReview[]
  approvedFoods               Food[]               @relation("FoodApprover")
  mealPreferences             MealPreference[]
  notifications               Notification[]
  orders                      Order[]
  approvedPackages            Package[]            @relation("PackageApprover")
  payments                    Payment[]
  subscriptions               Subscription[]
  addresses                   UserAddress[]
  devices                     UserDevice[]
  loginHistory                UserLoginHistory[]
  otps                        UserOTP[]
  userPermissions             UserPermission[]
  sessions                    UserSession[]
  tokens                      UserToken[]
  vendor                      Vendor?              @relation(fields: [vendorId], references: [id])
  packageReviews              PackageReview[]

  @@index([role])
  @@index([status])
  @@index([role, deletedAt])
  @@map("users")
}

model UserAddress {
  id                  String    @id @default(uuid())
  userId              String
  label               String?
  receiverName        String
  receiverPhone       String
  country             String?
  division            String
  district            String
  upazila             String?
  area                String
  road                String?
  house               String?
  floor               String?
  apartment           String?
  landmark            String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  deliveryInstruction String?
  isDefault           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  user                User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_addresses")
}

model UserDevice {
  id              String    @id @default(uuid())
  userId          String
  deviceId        String
  deviceName      String?
  deviceType      String
  operatingSystem String?
  osVersion       String?
  appVersion      String?
  browser         String?
  pushToken       String
  ipAddress       String?
  lastActiveAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_devices")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  deviceId     String?
  accessToken  String
  refreshToken String
  ipAddress    String?
  loginAt      DateTime?
  expiresAt    DateTime
  logoutAt     DateTime?
  status       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accessToken])
  @@index([refreshToken, status])
  @@index([status])
  @@map("user_sessions")
}

model UserOTP {
  id           String    @id @default(uuid())
  userId       String?
  phone        String?
  email        String?
  otp          String
  purpose      String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attemptCount Int       @default(0)
  status       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([phone])
  @@index([otp])
  @@index([status])
  @@map("user_otps")
}

model UserToken {
  id        String    @id @default(uuid())
  userId    String
  token     String
  type      String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([token])
  @@map("user_tokens")
}

model UserLoginHistory {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String?
  ipAddress   String?
  browser     String?
  platform    String?
  country     String?
  city        String?
  loginMethod String?
  loginStatus String?
  loggedInAt  DateTime?
  loggedOutAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_login_histories")
}

model UserPermission {
  id        String   @id @default(uuid())
  userId    String
  module    String
  type      String   @default("GRANT")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, module, type])
  @@map("user_permissions")
}

model Vendor {
  id                    String                 @id @default(uuid())
  vendorCode            String                 @unique
  businessName          String
  ownerName             String
  phone                 String                 @unique
  email                 String                 @unique
  tradeLicenseNumber    String                 @unique
  tinNumber             String                 @unique
  binNumber             String                 @unique
  logo                  String?
  coverImage            String?
  description           String?
  status                VendorStatus           @default(PENDING)
  verificationStatus    VerificationStatus     @default(UNVERIFIED)
  isActive              Boolean                @default(true)
  isOnline              Boolean                @default(false)
  commissionType        CommissionType         @default(PERCENTAGE)
  commissionValue       Decimal                @default(0.00) @db.Decimal(10, 2)
  openingTime           String?
  closingTime           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  deliveries            Delivery[]
  inventories           Inventory[]
  orders                Order[]
  packages              Package[]
  platformRevenues      PlatformRevenue[]
  purchases             Purchase[]
  riders                Rider[]
  routes                Route[]
  suppliers             Supplier[]
  user                  User?
  activityLogs          VendorActivityLog[]
  bankAccounts          VendorBankAccount[]
  branches              VendorBranch[]
  commissions           VendorCommission[]
  documents             VendorDocument[]
  vendorFoodAssignments VendorFoodAssignment[]
  vendorFoods           VendorFood[]
  holidays              VendorHoliday[]
  kitchens              VendorKitchen[]
  operatingHours        VendorOperatingHour[]
  profile               VendorProfile?
  rating                VendorRating?
  reviews               VendorReview[]
  serviceAreas          VendorServiceArea[]
  settings              VendorSettings?
  settlements           VendorSettlement[]
  subscriptions         VendorSubscription[]
  wallet                VendorWallet?
  zones                 VendorZone[]

  @@index([status])
  @@index([verificationStatus])
  @@index([isActive])
  @@map("vendors")
}

model VendorProfile {
  id               String   @id @default(uuid())
  vendorId         String   @unique
  businessType     String?
  businessCategory String?
  foundedYear      Int?
  employeeCount    Int?
  website          String?
  facebook         String?
  instagram        String?
  youtube          String?
  description      String?
  mission          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  vendor           Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_profiles")
}

model VendorBranch {
  id           String          @id @default(uuid())
  vendorId     String
  branchName   String
  branchCode   String          @unique
  phone        String?
  email        String?
  country      String?
  division     String?
  district     String?
  upazila      String?
  area         String?
  road         String?
  house        String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  isMainBranch Boolean         @default(false)
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vendor       Vendor          @relation(fields: [vendorId], references: [id])
  kitchens     VendorKitchen[]

  @@map("vendor_branches")
}

model VendorKitchen {
  id              String        @id @default(uuid())
  vendorId        String
  branchId        String?
  kitchenName     String
  kitchenCode     String        @unique
  capacity        Int?
  preparationTime Int?
  status          String        @default("active")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  branch          VendorBranch? @relation(fields: [branchId], references: [id])
  vendor          Vendor        @relation(fields: [vendorId], references: [id])

  @@map("vendor_kitchens")
}

model VendorDocument {
  id                 String    @id @default(uuid())
  vendorId           String
  documentType       String
  documentNumber     String?
  documentFile       String
  issueDate          DateTime?
  expiryDate         DateTime?
  verificationStatus String    @default("pending")
  verifiedBy         String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  vendor             Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_documents")
}

model VendorBankAccount {
  id                  String   @id @default(uuid())
  vendorId            String
  bankName            String
  branchName          String?
  accountName         String
  accountNumber       String
  routingNumber       String?
  mobileBankingType   String?
  mobileBankingNumber String?
  isPrimary           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  vendor              Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_bank_accounts")
}

model VendorOperatingHour {
  id          String   @id @default(uuid())
  vendorId    String
  day         String
  openingTime String
  closingTime String
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_operating_hours")
}

model VendorHoliday {
  id          String   @id @default(uuid())
  vendorId    String
  holidayName String
  holidayDate DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_holidays")
}

model VendorServiceArea {
  id                    String   @id @default(uuid())
  vendorId              String
  division              String
  district              String
  upazila               String?
  area                  String
  deliveryCharge        Decimal? @db.Decimal(10, 2)
  minimumOrderAmount    Decimal? @db.Decimal(10, 2)
  estimatedDeliveryTime Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  vendor                Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_service_areas")
}

model VendorZone {
  id          String   @id @default(uuid())
  vendorId    String
  zoneName    String
  zoneCode    String?  @unique
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_zones")
}

model VendorSubscription {
  id            String   @id @default(uuid())
  vendorId      String
  planId        String?
  startDate     DateTime
  endDate       DateTime
  amount        Decimal  @db.Decimal(10, 2)
  paymentStatus String   @default("pending")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_subscriptions")
}

model VendorCommission {
  id                   String    @id @default(uuid())
  vendorId             String
  commissionType       String?
  commissionPercentage Decimal?  @db.Decimal(5, 2)
  flatAmount           Decimal?  @db.Decimal(10, 2)
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  status               String    @default("active")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  vendor               Vendor    @relation(fields: [vendorId], references: [id])

  @@map("vendor_commissions")
}

model VendorSettlement {
  id                    String                        @id @default(uuid())
  vendorId              String
  settlementNumber      String                        @unique
  settlementPeriodStart DateTime?
  settlementPeriodEnd   DateTime?
  totalOrders           Int?
  grossAmount           Decimal?                      @db.Decimal(10, 2)
  totalCommission       Decimal?                      @db.Decimal(10, 2)
  vatAmount             Decimal?                      @db.Decimal(10, 2)
  adjustmentAmount      Decimal?                      @db.Decimal(10, 2)
  totalPayable          Decimal?                      @db.Decimal(10, 2)
  netAmount             Decimal?                      @db.Decimal(10, 2)
  settlementDate        DateTime?
  paymentStatus         String                        @default("pending")
  transactionId         String?
  paymentDate           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  items                 VendorSettlementItem[]
  transactions          VendorSettlementTransaction[]
  vendor                Vendor                        @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([paymentStatus])
  @@map("vendor_settlements")
}

model VendorSettlementItem {
  id            String           @id @default(uuid())
  settlementId  String
  orderId       String
  orderAmount   Decimal          @db.Decimal(10, 2)
  commission    Decimal?         @db.Decimal(10, 2)
  adjustment    Decimal?         @db.Decimal(10, 2)
  payableAmount Decimal          @db.Decimal(10, 2)
  createdAt     DateTime         @default(now())
  settlement    VendorSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@map("vendor_settlement_items")
}

model VendorSettlementTransaction {
  id            String           @id @default(uuid())
  settlementId  String
  transactionId String?
  bankAccountId String?
  amount        Decimal          @db.Decimal(10, 2)
  paymentMethod String?
  status        String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  settlement    VendorSettlement @relation(fields: [settlementId], references: [id])

  @@map("vendor_settlement_transactions")
}

model VendorWallet {
  id           String                    @id @default(uuid())
  vendorId     String                    @unique
  balance      Decimal                   @default(0) @db.Decimal(10, 2)
  holdBalance  Decimal                   @default(0) @db.Decimal(10, 2)
  currency     String                    @default("BDT")
  status       String                    @default("active")
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  transactions VendorWalletTransaction[]
  vendor       Vendor                    @relation(fields: [vendorId], references: [id])

  @@map("vendor_wallets")
}

model VendorWalletTransaction {
  id              String       @id @default(uuid())
  walletId        String
  transactionType String
  amount          Decimal      @db.Decimal(10, 2)
  balanceBefore   Decimal?     @db.Decimal(10, 2)
  balanceAfter    Decimal?     @db.Decimal(10, 2)
  referenceId     String?
  remarks         String?
  createdAt       DateTime     @default(now())
  wallet          VendorWallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@map("vendor_wallet_transactions")
}

model VendorRating {
  id            String   @id @default(uuid())
  vendorId      String   @unique
  averageRating Float?   @default(0)
  totalRating   Int?     @default(0)
  fiveStar      Int?     @default(0)
  fourStar      Int?     @default(0)
  threeStar     Int?     @default(0)
  twoStar       Int?     @default(0)
  oneStar       Int?     @default(0)
  updatedAt     DateTime @updatedAt
  vendor        Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_ratings")
}

model VendorReview {
  id         String   @id @default(uuid())
  vendorId   String
  customerId String
  rating     Int
  review     String?
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vendor     Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_reviews")
}

model VendorSettings {
  id                  String   @id @default(uuid())
  vendorId            String   @unique
  autoAcceptOrder     Boolean  @default(false)
  autoAssignRider     Boolean  @default(false)
  allowCustomMeal     Boolean  @default(true)
  allowPackage        Boolean  @default(true)
  notificationEnabled Boolean  @default(true)
  smsEnabled          Boolean  @default(false)
  emailEnabled        Boolean  @default(false)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  vendor              Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_settings")
}

model VendorActivityLog {
  id        String   @id @default(uuid())
  vendorId  String
  staffId   String?
  activity  String
  module    String?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id])

  @@map("vendor_activity_logs")
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  icon          String?
  image         String?
  sortOrder     Int           @default(0)
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  popular       Boolean       @default(false)
  foods         Food[]
  subCategories SubCategory[]

  @@index([status])
  @@map("categories")
}

model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  sortOrder   Int       @default(0)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  foods       Food[]
  category    Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@map("sub_categories")
}

model Food {
  id                    String                 @id @default(uuid())
  categoryId            String
  subCategoryId         String?
  foodCode              String                 @unique
  name                  String
  slug                  String                 @unique
  shortDescription      String?
  description           String?
  thumbnail             String?
  coverImage            String?
  preparationTime       Int?
  calories              Float?
  protein               Float?
  fat                   Float?
  carbohydrate          Float?
  servingSize           String?
  foodType              FoodType
  spiceLevel            String?
  isFeatured            Boolean                @default(false)
  isPopular             Boolean                @default(false)
  isRecommended         Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  approvedAt            DateTime?
  approvedBy            String?
  averageRating         Float?                 @default(0)
  cholesterol           Float?
  fiber                 Float?
  fiveStar              Int?                   @default(0)
  fourStar              Int?                   @default(0)
  oneStar               Int?                   @default(0)
  rejectionReason       String?
  sodium                Float?
  sugar                 Float?
  threeStar             Int?                   @default(0)
  totalReview           Int?                   @default(0)
  twoStar               Int?                   @default(0)
  status                FoodStatus             @default(PENDING)
  cartItems             CartItem[]
  cartMealFoods         CartMealFood[]
  addons                FoodAddon[]
  allergens             FoodAllergen[]
  availability          FoodAvailability?
  diets                 FoodDiet[]
  discounts             FoodDiscount[]
  favorites             FoodFavorite[]
  images                FoodImage[]
  ingredients           FoodIngredient[]
  labels                FoodLabel[]
  preparation           FoodPreparation?
  prices                FoodPrice[]
  reviews               FoodReview[]
  schedules             FoodSchedule[]
  tagMappings           FoodTagMapping[]
  variants              FoodVariant[]
  visibility            FoodVisibility?
  approver              User?                  @relation("FoodApprover", fields: [approvedBy], references: [id])
  category              Category               @relation(fields: [categoryId], references: [id])
  subCategory           SubCategory?           @relation(fields: [subCategoryId], references: [id])
  orderItems            OrderItem[]
  packageMealFoods      PackageMealFood[]
  vendorFoodAssignments VendorFoodAssignment[]
  vendorFoods           VendorFood[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isPopular])
  @@index([status, deletedAt, categoryId])
  @@map("foods")
}

model FoodVariant {
  id            String   @id @default(uuid())
  foodId        String
  name          String
  description   String?
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  weight        String?
  servingSize   String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  food          Food     @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@index([status])
  @@map("food_variants")
}

model FoodAddon {
  id           String          @id @default(uuid())
  foodId       String
  name         String
  isRequired   Boolean         @default(false)
  maxSelection Int?
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        FoodAddonItem[]
  food         Food            @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@index([status])
  @@map("food_addons")
}

model FoodAddonItem {
  id        String    @id @default(uuid())
  addonId   String
  name      String
  price     Decimal   @db.Decimal(10, 2)
  image     String?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  addon     FoodAddon @relation(fields: [addonId], references: [id])

  @@index([addonId])
  @@index([status])
  @@map("food_addon_items")
}

model FoodIngredient {
  id             String   @id @default(uuid())
  foodId         String
  ingredientName String
  quantity       String?
  unit           String?
  isOptional     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  food           Food     @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@map("food_ingredients")
}

model FoodAllergen {
  id          String   @id @default(uuid())
  foodId      String
  allergen    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  food        Food     @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@map("food_allergens")
}

model FoodPreparation {
  id                 String   @id @default(uuid())
  foodId             String   @unique
  preparationTime    Int?
  cookTime           Int?
  packingTime        Int?
  estimatedReadyTime Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  food               Food     @relation(fields: [foodId], references: [id])

  @@map("food_preparations")
}

model FoodAvailability {
  id            String   @id @default(uuid())
  foodId        String   @unique
  availableFrom String?
  availableTo   String?
  isAvailable   Boolean  @default(true)
  availableDays Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  food          Food     @relation(fields: [foodId], references: [id])

  @@map("food_availabilities")
}

model FoodSchedule {
  id        String   @id @default(uuid())
  foodId    String
  mealType  MealType
  startTime String
  endTime   String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  food      Food     @relation(fields: [foodId], references: [id])

  @@index([foodId])
  @@index([mealType])
  @@map("food_schedules")
}

model FoodPrice {
  id            String    @id @default(uuid())
  foodId        String
  basePrice     Decimal   @db.Decimal(10, 2)
  salePrice     Decimal?  @db.Decimal(10, 2)
  currency      String    @default("BDT")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
